# =====================================================
# Plant Disease Detection — Environment Variables
# =====================================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your real values
# 3. Never commit .env to git!
# =====================================================

# JWT secret — change this to a long random string
SECRET_KEY=your_super_secret_jwt_key_change_this

# MongoDB (used by docker-compose)
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGODB_DB_NAME=crop_disease_db

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
DEBUG=False
ENVIRONMENT=production

# For local development (without Docker), point to localhost
# MONGODB_URL=mongodb://localhost:27017/crop_disease_db
# REDIS_URL=redis://localhost:6379/0
